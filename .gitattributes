# Normalize text files and use LF in the working tree by default.
* text=auto eol=lf

# Maven wrapper and shell scripts
mvnw text eol=lf
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets and archives
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.jar binary
*.war binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
