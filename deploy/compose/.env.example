# ==============================================================================
# TicketNow Platform - Environment Configuration Template
# Copy this file to .env in deploy/compose/ for local Docker Compose & services.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (MariaDB 12.3)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3307
DB_ROOT_USERNAME=root
DB_ROOT_PASSWORD=change-me-root
DB_USERNAME=event_user
DB_PASSWORD=change-me-event
DB_NAME=ticketnow_event

# Database-per-Service Database Names
EVENT_DB_NAME=ticketnow_event
INVENTORY_DB_NAME=ticketnow_inventory
BOOKING_DB_NAME=ticketnow_booking
PAYMENT_DB_NAME=ticketnow_payment
TICKET_DB_NAME=ticketnow_ticket
NOTIFICATION_DB_NAME=ticketnow_notification

# ------------------------------------------------------------------------------
# 2. Redis (Cache & Distributed Lock)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. Apache Kafka 3.8 (KRaft Mode)
# ------------------------------------------------------------------------------
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ------------------------------------------------------------------------------
# 4. Keycloak IAM (OAuth2 / OIDC)
# ------------------------------------------------------------------------------
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8180
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=ticketnow
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/ticketnow
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=change-me-keycloak-admin
KC_DEMO_PASSWORD=LocalDemo_2026

# ------------------------------------------------------------------------------
# 5. MinIO (S3-Compatible Object Storage)
# ------------------------------------------------------------------------------
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=ticketnow_minio
MINIO_BUCKET=ticketnow-tickets

# ------------------------------------------------------------------------------
# 6. MailHog (SMTP Testing Server)
# ------------------------------------------------------------------------------
MAILHOG_HOST=localhost
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ------------------------------------------------------------------------------
# 7. Payment Gateway Configuration (MOCK or PAYOS)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=MOCK
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=http://localhost:3000/checkout/success
PAYOS_CANCEL_URL=http://localhost:3000/checkout/cancel
MOCK_PAYMENT_DELAY_MS=0
MOCK_PAYMENT_AUTO_CONFIRM=false

# ------------------------------------------------------------------------------
# 8. Security & QR Code
# ------------------------------------------------------------------------------
TICKET_QR_SECRET=ticketnow_secret_qr_signature_key_2026

# ------------------------------------------------------------------------------
# 9. Microservices Ports & Gateway URLs
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
EVENT_SERVICE_PORT=8081
SEAT_INVENTORY_PORT=8083
SEAT_INVENTORY_GRPC_PORT=9083
BOOKING_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8085
TICKET_SERVICE_PORT=8086
NOTIFICATION_SERVICE_PORT=8087

GATEWAY_URL=http://localhost:8080
EVENT_SERVICE_URL=http://localhost:8081
SEAT_INVENTORY_URL=http://localhost:8083
BOOKING_SERVICE_URL=http://localhost:8084
PAYMENT_SERVICE_URL=http://localhost:8085
TICKET_SERVICE_URL=http://localhost:8086
NOTIFICATION_SERVICE_URL=http://localhost:8087
