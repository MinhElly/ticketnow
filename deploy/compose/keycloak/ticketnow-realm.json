{
  "realm": "ticketnow",
  "displayName": "TicketNow Local",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Ticket buyer"
      },
      {
        "name": "organizer",
        "description": "Event organizer"
      },
      {
        "name": "admin",
        "description": "TicketNow application administrator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ticketnow-postman",
      "name": "TicketNow Postman (local)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "ticketnow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ticketnow-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "ticketnow-web",
      "name": "TicketNow Web Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "ticketnow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ticketnow-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "customer01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Customer",
      "lastName": "Demo",
      "email": "customer01@example.com",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "${KC_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ]
    },
    {
      "username": "organizer01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Organizer",
      "lastName": "Demo",
      "email": "organizer01@example.com",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "${KC_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "organizer"
      ]
    },
    {
      "username": "admin01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Demo",
      "email": "admin01@example.com",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "${KC_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    }
  ]
}
